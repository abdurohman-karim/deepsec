# Настройки Windows-агента. Обычно этот файл создаёт `python -m deepsec setup`
# в C:\ProgramData\DeepSec\.env (папка доступна только SYSTEM и администраторам).

# Куда подключаться — эти данные печатает ./deploy.sh при первой выкладке сервера
SERVER_URL=wss://IP_СЕРВЕРА:8443/agent
SERVER_FINGERPRINT=
AGENT_TOKEN=
# Имя компьютера в боте (по умолчанию — имя Windows)
# AGENT_NAME=Home-PC

# Через «;»
TDATA_DIRS=C:\Users\me\AppData\Roaming\Telegram Desktop\tdata
DECOY_DIRS=C:\Users\me\AppData\Roaming\AyuGram Desktop\tdata

# exe=подписант1|подписант2; — кому можно читать tdata (проверяется ещё и валидность подписи)
# TRUSTED_PROCESSES=Telegram.exe=Telegram FZ-LLC|Telegram Messenger LLP;Updater.exe=Telegram FZ-LLC;MsMpEng.exe=Microsoft Corporation;MpDefenderCoreService.exe=Microsoft Corporation

# Авто-реакция на чтение tdata (когда защита «взведена»)
AUTO_KILL=true
AUTO_FIREWALL=true
AUTO_LOCK=false

ALERT_LOCAL_LOGONS=true
ALERT_NETWORK_LOGONS=false
FAILED_LOGON_THRESHOLD=3
FAILED_LOGON_WINDOW=300
SELFTEST_INTERVAL=600
