# Настройки сервера (бот + сторож + приём Windows-агентов). ./deploy.sh кладёт этот файл в /home/bots/deepsec/.env
# Отдельный бот от @BotFather — токены других ботов не подойдут.
BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Бот отвечает только ему.
OWNER_ID=

# Сторож аккаунта сам завершает украденные сеансы: https://my.telegram.org → API development tools.
# После заполнения: ./deploy.sh root@IP login
TG_API_ID=
TG_API_HASH=

# Генерируются сами при первом ./deploy.sh
TOTP_SECRET=
AGENT_TOKEN=

LISTEN_PORT=8443
TIMEZONE=Asia/Tashkent
AUTO_TERMINATE=true
# Сколько часов после кражи автоматически завершать любой новый вход в аккаунт
LOCKDOWN_HOURS=24
# Через сколько секунд молчания агента прислать «компьютер не на связи»
OFFLINE_ALERT_SECONDS=180
